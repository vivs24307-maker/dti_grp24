PORT=5000
# Required in production: the server refuses to start with NODE_ENV=production if this is
# missing or left as the placeholder. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Comma separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173
# DB_FILE=./data/cineverse.db
